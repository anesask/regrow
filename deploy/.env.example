# Public hostname; Caddy gets a Let's Encrypt certificate for it automatically (DNS A record must point here)
DOMAIN=regrow.living

# Chain (shared by API and web build)
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
WALLETCONNECT_PROJECT_ID=

# API secrets (never commit the filled-in .env)
# Oracle committee keys held by this server, comma separated (2 of the 3 committee signers; the third stays offline)
ORACLE_PRIVATE_KEYS=
# Pays gas to submit signed reports; holds no role. Also tops up demo wallets unless GAS_TANK_PRIVATE_KEY is set
RELAYER_PRIVATE_KEY=
GAS_TANK_PRIVATE_KEY=
# Oracle console passcode (/admin); use a long random string
ADMIN_PASSCODE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# cap on AI spend per day from visitors (photo check, Ask the evidence); pipeline runs are not capped
AI_DAILY_BUDGET_USD=0.50
